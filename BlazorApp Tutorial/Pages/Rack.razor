@page "/administrator/rack/{rackId}"
@page "/administrator/rack"

@using BlazorApp_Tutorial.Data

@inject NavigationManager NavigationManager
@inject ItemsRackService RackService

<h3>Rack Number @RackId: </h3>

<div class="col-12 row">

    <EditForm Model="@itemsRack">

         <div class="col-12 row">
            <label class="col-2 font-weight-bold">Codigo de Producto</label>
            <InputText class="form-control col-3" @bind-Value="itemsRack.ItemCode" placeholder="Codigo de Producto" />
         </div>
         <br />
         <div class="col-12 row">
            <label class="col-2 font-weight-bold">Numero de Productos</label>
            <InputNumber class="form-control col-3" @bind-Value="itemsRack.ItemNumb" placeholder="Numero de Productos" />
         </div>
         <br />
         <div class="col-12 row">
             <span class="col-2"></span>
             <input type="submit" class="form-control col-1 btn btn primary" value="Save" />
             <span>&nbsp;</span>
             <input type="submit" class="form-control col-1 btn btn primary" value="Clear" />
         </div>

     </EditForm>

</div>


    <!--...  <button class="btn btn-primary" @onclick="Submission">Submit</button>
    <button class="btn btn-primary" @onclick="Submission">Clear</button>-->

@if (rackItems == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name of Item</th>
                <th>Code of Item</th>
                <th>Number of Items</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rackItem in rackItems)
            {
                <tr>
                    <td>@rackItem.ItemName</td>
                    <td>@rackItem.ItemCode</td>
                    <td>@rackItem.ItemNumb</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    [Parameter]
    public string RackId { get; set; }

    public ItemsRack itemsRack { get; set; }

    private ItemsRack[]? rackItems;

    protected override void OnInitialized()
    {
        itemsRack = new ItemsRack();
    }

    private void Submission()
    {
        // DB Connection

    }

    protected override async Task OnInitializedAsync()
    {
        rackItems = await RackService.GetRackAsync();
    }

    private void SaveRackEntry()
    {
        
    }


}

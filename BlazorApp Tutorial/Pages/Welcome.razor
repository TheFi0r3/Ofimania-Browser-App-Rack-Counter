@page "/administrator"
@inject NavigationManager NavigationManager

<h1>Main Menu</h1>
<br>
<p>Welcome to the Main Menu!</p>
<br>
<p>Please select a rack to start cataloging</p>

@if (racks == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @foreach (string rack in racks)
    {
        <button class="btn btn-primary" @onclick="() => RackSorting(rack)">Rack @rack</button>
        <span>&nbsp;</span>
        <br>
        <br>
    }
}

<button class="btn btn-primary" @onclick="() => RackSorting()">Rack</button>

<button class="btn btn-primary" @onclick="CloseSession">Log Out</button>


@code {

    private static readonly string[] racks = new[]
    {
        "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching"
    };

    private void RackSorting(string rack)
    {
        NavigationManager.NavigateTo("/administrator/rack/" + @rack);
    }
    private void RackSorting()
    {
        NavigationManager.NavigateTo("/administrator/rack/rack0");
    }

    private void CloseSession()
    {
        NavigationManager.NavigateTo("/login");
    }
}


@page "/administrador"

@using Ofimania_Browser_App_Rack_Counter.Data
@using Ofimania_Browser_App_Rack_Counter.Services
@using Sybase_Data_Access
@using Sybase_Data_Access.Data
@using Sybase_Data_Access.Models

@inject NavigationManager NavigationManager
@inject RackStoreService StoreService
@inject LoginFormService LoginService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IEnc_InventarioData _dbstore
@inject IAlmacenData _dbname

<h1 style="font-weight:bold; color:blue">Menú Principal</h1>

<AuthorizeView>
    <Authorized>
        <p>¡Bienvenido <b>@context.User.Identity.Name</b>, al Servidor <b>@ServerName</b>!</p>
        <h4 h4 style="font-weight:lighter; color:black">Seleccione un Almacén para empezar a catalogar:</h4>
        <br />
        
        @if (rackStores== null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            @foreach (var rackStore in rackStores)
            {
                <button class="btn btn-primary" @onclick="() => StoreSorting(rackStore.StoreCode)">@rackStore.StoreName</button>
                <span>&nbsp;</span>
                <br>
                <br>
            }
        }
    </Authorized>
    <NotAuthorized>
        <p>¡Usted aún no ha iniciado sesión!</p>
        <br>
    </NotAuthorized>
</AuthorizeView>

@*<button class="btn btn-primary" @onclick="() => RackSorting()">Rack</button>
<button class="btn btn-primary" @onclick="CloseSession">Log Out</button>*@

@code {

    [Parameter]

    public string UserName { get; set; }
    public string ServerName{ get; set; }

    public RackStock rackStock { get; set; }

    private List<Enc_InventarioModel> rackAlmacen;
    private List<AlmacenModel> storeNames;

    public List<RackStore> rackStores { get; set; }

    protected override void OnInitialized()
    {
        rackStock = new RackStock();
    }

    protected override async Task OnInitializedAsync()
    {
        ServerName = await LoginService.GetServerName();

        try
        {
            rackAlmacen = await _dbstore.GetInventoryList("A");
            storeNames = await _dbname.GetStoreNames();
            await StoreService.LoadSQLStores(rackAlmacen, storeNames);
        }catch (Exception) { }

        rackStores = await StoreService.GetRackStores();
    }

    private void StoreSorting(string store)
    {
        NavigationManager.NavigateTo("/administrador/almacen/" + @store);
    }
    private void StoreSorting()
    {
        NavigationManager.NavigateTo("/administrador/rack");
    }
    private void CloseSession()
    {
        NavigationManager.NavigateTo("/login");
    }
}
@page "/administrator"
@using Ofimania_Browser_App_Rack_Counter.Data

@inject NavigationManager NavigationManager
@inject RackStockService StockService
@inject AuthenticationStateProvider AuthenticationStateProvider



<h1 style="font-weight:bold; color:blue">Menú Principal</h1>

<AuthorizeView>
    <Authorized>

        <p>¡Bienvenido <b>@context.User.Identity?.Name</b>, al Menú Principal!</p>
        <h4 h4 style="font-weight:lighter; color:black">Seleccione un rack para empezar a catalogar:</h4>
        <br />
        @if (rackStocks == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            @foreach (var rackStock in rackStocks)
            {
                <button class="btn btn-primary" @onclick="() => RackSorting(rackStock.RackName)">Rack @rackStock.RackName</button>
                <span>&nbsp;</span>
                <br>
                <br>
            }
        }
    </Authorized>
    <NotAuthorized>

        <p>¡Usted aún no ha iniciado sesión!</p>
        <br>

    </NotAuthorized>
</AuthorizeView>


@*<button class="btn btn-primary" @onclick="() => RackSorting()">Rack</button>
<button class="btn btn-primary" @onclick="CloseSession">Log Out</button>*@


@code {

    [Parameter]
    public RackStock rackStock { get; set; }
    public List<RackStock> rackStocks { get; set; }

    protected override void OnInitialized()
    {
                rackStock = new RackStock();
    }

    protected override async Task OnInitializedAsync()
    {
        rackStocks = await StockService.GetRackStocks();
    }

    private void RackSorting(string rack)
    {
        NavigationManager.NavigateTo("/administrator/rack/" + @rack);
    }
    private void RackSorting()
    {
        NavigationManager.NavigateTo("/administrator/rack/rack0");
    }
    private void CloseSession()
    {
        NavigationManager.NavigateTo("/login");
    }
}


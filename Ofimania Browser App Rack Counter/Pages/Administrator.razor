@page "/administrator"
@using BlazorApp_Tutorial.Data
@inject NavigationManager NavigationManager
@inject RackStockService StockService

<h1>Menu Principal</h1>

<AuthorizeView>
    <Authorized>
        <p>¡Bienvenido @UserName, al Menu Principal!</p>
        <p>Seleccione un Rack para Empezar a Catalogar</p>

        @if (racks == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            @foreach (var rackStock in rackStocks)
            {
                <button class="btn btn-primary" @onclick="() => RackSorting(rackStock.RackName)">Rack @rackStock.RackName</button>
                <span>&nbsp;</span>
                <br>
                <br>
            }
        }
    </Authorized>
    <NotAuthorized>

        <p>¡Usted aun no ha iniciado sesion!</p>

    </NotAuthorized>
</AuthorizeView>





<br>


@*<button class="btn btn-primary" @onclick="() => RackSorting()">Rack</button>
<button class="btn btn-primary" @onclick="CloseSession">Log Out</button>*@


@code {

    private static readonly string[] racks = new[]
    {
        "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching"
    };

    [Parameter]
    public string UserId { get; set; }
    public string UserName { get; set; }

    public RackStock rackStock { get; set; }
    public List<RackStock> rackStocks { get; set; }


    protected override void OnInitialized()
    {
        UserId = "Antonio Andres Fiore";
        UserName = UserId;
        rackStock = new RackStock();
    }

    protected override async Task OnInitializedAsync()
    {
        rackStocks = await StockService.GetRackStocks();
    }

    private void RackSorting(string rack)
    {
        NavigationManager.NavigateTo("/administrator/rack/" + @rack);
    }
    private void RackSorting()
    {
        NavigationManager.NavigateTo("/administrator/rack/rack0");
    }
    private void CloseSession()
    {
        NavigationManager.NavigateTo("/login");
    }
}


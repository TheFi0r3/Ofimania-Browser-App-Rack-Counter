@page "/"
@layout LoginLayout
@inject NavigationManager NavigationManager;

<PageTitle>Welcome!</PageTitle>

<h1 style="font-weight:bold; color:blue">¡Bienvenido!</h1>
<div>
    <br /><br /><br />
    <div class="col-4 row">
        <button class="btn btn-primary" @onclick="StartUpSybase">Iniciar</button>
    </div>
</div>

@code {
    private void StartUpSybase()
    {
        NavigationManager.NavigateTo("/login");
    }
}


@page "/login"
@layout LoginLayout

@using Ofimania_Browser_App_Rack_Counter.Data
@using Ofimania_Browser_App_Rack_Counter.Services
@using Sybase_Data_Access
@using Sybase_Data_Access.Data
@using Sybase_Data_Access.Models

@inject NavigationManager NavigationManager
@inject LoginFormService LoginForm
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject ISQLDataAccess SybaseAccess

<PageTitle>Log In</PageTitle>

<h1 style="font-weight:bold; color:blue">¡Bienvenido!</h1><br />
<label class="col-12 font-weight-bold">Hoy es: @DateTime.Now</label>
<br />
<br />

<div class="col-12 row">
   
    <h4 style="font-weight:lighter; color:black">Coloque sus datos de usuario:</h4><br>

    <EditForm Model="@loginForm" OnValidSubmit="@LoginSybase" OnInvalidSubmit="@FailedLogin">
        <DataAnnotationsValidator  />
        <div class="col-12 row">
            <label class="col-12 font-weight-bold" style="text-align:left">Nombre de Usuario</label>
            <InputText class="form-control col-3" @bind-Value="loginForm.UserId" placeholder="Nombre de Usuario" />
        </div>
        <br/>
        <div class="col-12 row">
            <label class="col-12 font-weight-bold" style="text-align:left">Contraseña</label>
            <InputText type="password" class="form-control col-3" @bind-Value="loginForm.UserPassword" placeholder="Contraseña" />
        </div>
        <br /><br />
        <div class="col-6 row">
            <span class="col-6 row"></span>
            <input type="submit" class="form-control btn btn-primary" value="Iniciar Sesión" />
        </div>
        <br />
    </EditForm>
</div>

@code {

    public LoginForm loginForm { get; set; }
    public LoginForm loginData { get; set; }

    protected override void OnInitialized()
    {
        loginForm = new LoginForm();
        loginData = new LoginForm();
    }

    private async Task<bool> LoginSybase()
    {
        await SybaseAccess.SetConnection(loginForm.UserId, loginForm.UserPassword);
        if (await SybaseAccess.CheckConnection())
        {
            await LoginForm.SetId(loginForm.UserId, loginForm.UserPassword);
            ((CustomAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsLoggedIn(loginForm.UserId);
            NavigationManager.NavigateTo("/administrador");
            await SessionStorage.SetItemAsync("UserId", loginForm.UserId);
        }
        else
        {
            await FailedLogin();
        }

        return await Task.FromResult(true);
    }

    private async Task<bool> FailedLogin()
    {

//        ((CustomAuthenticationStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();

        NavigationManager.NavigateTo("/loginerror");

        return await Task.FromResult(false);
    }
}


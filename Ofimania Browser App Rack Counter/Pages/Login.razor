@page "/login"
@layout LoginLayout
@using BlazorApp_Tutorial.Data;
@inject NavigationManager NavigationManager;
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Log In</PageTitle>

<h1 style="font-weight:bold; color:blue">¡Bienvenido!</h1><br />
<label class="col-12 font-weight-bold">Hoy es: @DateTime.Now</label>
<br />
<br />

<div class="col-12 row">
   
    <h4 style="font-weight:lighter; color:black">Coloque sus datos de usuario:</h4><br>

    <EditForm Model="@loginForm" OnValidSubmit="@LoginSybase">

        <div class="col-12 row">
            <label class="col-12 font-weight-bold" style="text-align:left">Nombre de Usuario</label>
            <InputText class="form-control col-3" @bind-Value="loginForm.UserId" placeholder="Nombre de Usuario" />
        </div>
        <br/>
        <div class="col-12 row">
            <label class="col-12 font-weight-bold" style="text-align:left">Contraseña</label>
            <InputText class="form-control col-3" @bind-Value="loginForm.UserPassword" placeholder="Contraseña" />
        </div>
        <br /><br />
        <div class="col-6 row">
            <span class="col-6 row"></span>
            <input type="submit" class="form-control btn btn-primary" value="Log Me In" />
        </div>
        <br />
    </EditForm>
</div>

@code {

    private int currentCount = 0;
    private int loginDetails = 0;

    public LoginForms loginForm { get; set; }

    protected override void OnInitialized()
    {
        loginForm = new LoginForms();
    }

    private async Task<bool> LoginSybase()
    {
        // DB Connection
        loginDetails = 1;
        //

        ((CustomAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsAuthenticated(loginForm.UserId);

        if (loginDetails != 0)
        {
            NavigationManager.NavigateTo("/administrator");
        }
        else
        {
            NavigationManager.NavigateTo("/loginerror");
        }

        currentCount++;

        return await Task.FromResult(true);
    }

}

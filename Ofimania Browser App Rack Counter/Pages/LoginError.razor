@page "/loginerror"
@layout LoginLayout
@inject NavigationManager NavigationManager

<h1 style="font-weight:bold; color:blue">¡Bienvenido!</h1>
<br />
<label class="col-12 font-weight-bold">Hoy es: @DateTime.Now</label>
<br />
<br />

<div class="col-12 row">

    <h4 style="font-weight:lighter; color:black">¡Error!: Sus credenciales son inválidas</h4><br>
        <br /><br /><br />
</div>

<div class="col-4 ">
    <button class="btn btn-primary" @onclick="CloseSession">Regresar</button>
</div>

@code {

    private void CloseSession()
    {
        NavigationManager.NavigateTo("/login");
    }
}

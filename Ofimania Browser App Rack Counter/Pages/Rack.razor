@page "/administrador/rack/{storeId}/{rackId}/{countNumb}"
@*@page "/administrador/rack/{storeId}/{rackId}"
@page "/administrador/rack/{rackId}"
@page "/administrador/rack"*@

@using Ofimania_Browser_App_Rack_Counter.Data
@using Ofimania_Browser_App_Rack_Counter.Services
@using Sybase_Data_Access
@using Sybase_Data_Access.Data
@using Sybase_Data_Access.Models

@inject NavigationManager NavigationManager
@inject ItemRackService RackService
@inject ItemCountService CountService
@inject LoginFormService LoginService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime;

@inject IRackMovilData _dbrack
@inject IProductoData _dbprod
@inject IAlmacenData _dbstore
@inject IPasilloData _dbasile
@inject ISeccionData _dbsecc
@inject IUbicacionData _dblocat
@inject IProducto_ReferenciaData _dbref

@if (rackExists)
{
    <h1 style="font-weight:bold; color:blue">@StoreName - Rack Número @RackId:</h1>
    <h3 style="font-weight:bold; color:blue">Sección @SeccionName - @AsileName</h3>
}
else
{
    <h1 style="font-weight:bold; color:blue">Menú Principal</h1>
    <p><em>¡Este Rack no existe!</em></p>
    <br>
}
@if (itemsRack == null)
{
    <p><em>Loading...</em></p>
}
else if (rackNotEmpty & rackNotCounted)
{
    <div class="col-14">
        <br /><br />
        <center>
            <div class="col-12 row">
                <div class="col-12">
                    <EditForm Model="@itemCount" OnValidSubmit="@SubmitItem" OnInvalidSubmit="@DeleteItem">
                        <!--<div class="col-12 row">
                            <label class="col-12 font-weight-bold" style="text-align:left">Código de Producto</label>
                            <InputText id="ItmNo" class="form-control col-5" @onkeypress="@Tab" @bind-Value="itemCount.ItemCode" placeholder="Código de Producto" />
                        </div>
                        <br />-->
                        <div class="col-12 row">
                            <label class="col-12 font-weight-bold" style="text-align:left">Código de Barra</label>
                            <InputText id="ItmName" class="form-control col-5" @onkeypress="@Tab" @bind-Value="itemCount.ItemBarCode" placeholder="Código de Barra" />
                        </div>
                        <br />
                        <!--<div class="col-12 row">
                            <label class="col-12 font-weight-bold" style="text-align:left">Nombre de Producto</label>
                            <InputText class="form-control col-5" @onkeypress="@Tab" @bind-Value="itemCount.ItemName" placeholder="Nombre de Producto" />
                        </div>
                        <br />-->
                        <div class="col-12 row">
                            <label class="col-12 font-weight-bold" style="text-align:left">Número de Productos</label>
                            <InputNumber id="ItmDescription" class="form-control col-5" @onkeypress="@Enter" @bind-Value="itemCount.ItemNumb" placeholder="Número de Productos" />
                        </div>
                        <br />
                        <div class="col-10 row">
                            <center>
                                <span class="col-10 row">
                                    <input type="button" class="form-control col-2 btn btn-primary" @onclick="SubmitItem" value="Añadir" />
                                    <span>&nbsp;</span>
                                    <!--<input type="button" class="form-control col-2 btn btn-primary" @onclick="DeleteItem" value="Borrar" />
                                    <span>&nbsp;</span>-->
                                    <!--<input type="button" class="form-control col-2 btn btn-primary" @onclick="ClearForm" value="Limpíar" />
                                    <span>&nbsp;</span>-->
                                    <input type="button" class="form-control col-2 btn btn-primary" @onclick="FinishCount" value="Finalizar" />
                                    <span>&nbsp;</span>
                                    <input type="button" class="form-control col-2 btn btn-primary" @onclick="ShowHideRack" value="Conteo Previo" />
                                    <span>&nbsp;</span>
                                </span>
                            </center>
                        </div>
                    </EditForm>
                    <div class="col-8 row">
                        <span class="col-8 row">
                            <!--...  <button class="btn btn-primary" @onclick="Submission">Submit</button>
                            <button class="btn btn-primary" @onclick="Submission">Clear</button>-->
                        </span>
                    </div>
                </div>
            </div>
        </center>
    </div>
}
else @if (rackNotEmpty & !rackNotCounted)
{
    <p><em>¡Este Rack ya fue contado!</em></p>
    <br>
    <div class="col-14">
        <br /><br />
        <center>
            <div class="col-12 row">
                <div class="col-12">
                    <div class="col-10 row">
                        <center>
                            <span class="col-10 row">
                                <input type="button" class="form-control col-2 btn btn-primary" @onclick="FinishCount" value="Regresar" />
                                <span>&nbsp;</span>
                                <input type="button" class="form-control col-2 btn btn-primary" @onclick="ShowHideRack" value="Conteo Previo" />
                                <span>&nbsp;</span>
                            </span>
                        </center>
                    </div>
                </div>
            </div>
        </center>
    </div>
}
else
{
    @if (rackExists)
    {
    <p><em>¡Este Rack no esta asignado para Usted!</em></p>
    <br>
    }
}
<AuthorizeView>
    <Authorized>
        @if (itemsRack == null)
        {
            <p><em>Loading...</em></p>
        }
        else if ( showHide == true)
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre de Producto</th>
                        <th>Código de Producto</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rackItem in itemsRack)
                    {
                        <tr>
                            <td>@rackItem.ItemName</td>
                                    <td>@rackItem.ItemBarCode</td>
                            <td>@rackItem.ItemNumb</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (itemsRack == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            @if (rackNotCounted)
            {
            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre de Producto</th>
                        <th>Código de Producto</th>
                        <th>Cantidad</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rackItem in itemsCount)
                    {
                        <tr>
                            @if (!rackItem.ItemInRack)
                            {<td>*@rackItem.ItemName</td>}
                            else{<td>@rackItem.ItemName</td>}
                            <td>@rackItem.ItemBarCode</td>
                            <td>@rackItem.ItemNumb</td>
                        </tr>
                    }
                </tbody>
            </table>
            }
        }
    </Authorized>
    <NotAuthorized>
        <p>¡Usted aún no ha iniciado sesión!</p>
        <br>
    </NotAuthorized>
</AuthorizeView>

@code {

    [Parameter]
    public string RackId { get; set; }
    [Parameter]
    public string StoreId { get; set; }
    [Parameter]
    public string CountNumb { get; set; }

    private bool showHide { get; set; }
    private bool rackNotEmpty { get; set; }
    private bool rackNotCounted { get; set; }
    private bool rackExists { get; set; }

    public string StoreName { get; set; }
    public string UserName { get; set; }
    public string AsileName { get; set; }
    public string SeccionName { get; set; }

    public string KeyPressed = "";

    public productDtoVM product = new productDtoVM();

    public ItemRack itemRack { get; set; }
    public List<ItemRack> itemsRack { get; set; }

    public ItemRack itemCount { get; set; }
    public List<ItemRack> itemsCount { get; set; }

    protected override void OnInitialized()
    {
        showHide = false;
        rackNotEmpty = false;
        rackNotCounted = true;
        rackExists = true;
        itemRack = new ItemRack();
        itemCount = new ItemRack();
    }

    protected override async Task OnInitializedAsync()
    {
        await NamingElements();
        UserName = await LoginService.GetId();

        try
        {
            var rackCounted = await _dbrack.CheckRackList(UserName, CountNumb, RackId);

            if (rackCounted != null)
                try { var rackid = rackCounted.First().CODRACK; }
                catch (Exception) { rackNotCounted = false; }

            showHide = false;
            rackNotEmpty = false;

            var rackProductList = await _dbrack.GetProductList(RackId, UserName, CountNumb);

            foreach (var rackprod in rackProductList)
            {
                var prodCount = await _dbrack.GetProductCount(RackId, rackprod.CODPROD, CountNumb);
                var rackProductRack = await _dbrack.GetProductData(RackId, rackprod.CODPROD);
                var rackProductData = await _dbprod.GetProductInfo(rackprod.CODPROD);
                await RackService.LoadSQLProduct(rackProductData, rackProductRack, prodCount);
                rackNotEmpty = true;
            }

        }catch (Exception) { rackExists = false; }

        itemsRack = await RackService.GetItemsRack();
        itemsCount = await CountService.GetItemsRack();
    }

    private async Task NamingElements()
    {
        try {
            var rackLocation = await _dblocat.GetLocationCodes(RackId);
            var storeNames = await _dbstore.GetStoreName(rackLocation.First().CODALMACEN);
            var seccionNames = await _dbsecc.GetSeccionName(rackLocation.First().SECCION);
            var asileNames = await _dbasile.GetAsileName(rackLocation.First().NUMPASI.ToString());

            StoreName = storeNames.First().DESC_ALMACEN;
            SeccionName = seccionNames.First().DESSEC;
            AsileName = asileNames.First().DESCRIPCION;
        } catch (Exception) { rackExists = false; }
    }

    public class productDtoVM
    {
        public string ItmNo { get; set; }
        public string ItmName { get; set; }
        public string ItmDescription { get; set; }
    }

    public async Task Enter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")// Covers: Enter + NumPad Enter + Mobile keyboard Go to(enter)
        {
            await SubmitItem();
        }
    }

    public async Task Tab(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")// Covers: Enter + NumPad Enter + Mobile keyboard Go to(enter)
        {
            JSRuntime.InvokeVoidAsync("onFocus", "ItmNo");
        }
    }

    private async Task SubmitItem()
    {
        var prodcode = await _dbref.GetProdCode(itemCount.ItemBarCode);

        if (itemCount.ItemCode == null & prodcode != null & itemCount.ItemBarCode != null) 
            try {itemCount.ItemCode = prodcode.First().CODPROD;}
            catch (Exception) { await JSRuntime.InvokeVoidAsync("errorBarCode"); }

        try
        {// DB Connection
            var rackProductData = await _dbprod.GetProductInfo(itemCount.ItemCode);
            var rackProductList = await _dbrack.GetProductList(RackId, await LoginService.GetId(), CountNumb);

            var opstate = await CountService.SaveItemRack(itemCount, rackProductData, rackProductList);

            if (!opstate) await JSRuntime.InvokeVoidAsync("errorNoProduct");

        }catch(Exception)
        {
            await ClearForm();
            await JSRuntime.InvokeVoidAsync("errorInvalidInput");
        }

        var itemToUpdate = await CountService.GetItemByCode(itemCount.ItemCode);

        if (itemToUpdate != null)
        {
            try { await UpdatetoDB(itemToUpdate); }//SEND TO DB
            catch (Exception) 
            {   
                await DeleteItem();
                await JSRuntime.InvokeVoidAsync("errorInvalidInput");
            }
        }

        itemRack = new ItemRack();
        itemCount = new ItemRack();
    }

    private async Task DeleteItem()
    {
        await CountService.DeleteItemRack(itemCount);

        itemRack = new ItemRack();
        itemCount = new ItemRack();
    }

    private async Task ClearForm()
    {
        itemRack = new ItemRack();
        itemCount = new ItemRack();
    }

    private async Task FinishCount()
    {
        //foreach (var itemCount in itemsCount)
        //{   
            //try { await UpdatetoDB(itemToUpdate); }//SEND TO DB
            //catch (Exception) { await JSRuntime.InvokeVoidAsync("errorInvalidInput"); await ClearForm(); }
        //}
        NavigationManager.NavigateTo("/administrador/almacen/" + @StoreId);
    }

    private async Task UpdatetoDB(ItemRack itemCount)
    {
        if (itemCount.ItemInRack)
        {
            await _dbrack.UpdateRackMovil(CountNumb, itemCount.ItemNumb.ToString(), RackId, itemCount.ItemCode);
        }
        else
        {
            try
            {
                await _dbrack.InsertRackMovil(CountNumb, itemCount.ItemNumb.ToString(), RackId, itemCount.ItemCode, "0001", StoreId, UserName, itemCount.ItemBarCode);
            }
            catch (Exception)
            {
                await _dbrack.UpdateRackMovil(CountNumb, itemCount.ItemNumb.ToString(), RackId, itemCount.ItemCode);
            }
        }
    }

    private async Task ShowHideRack()
    {
        if(showHide == false){ showHide = true; }else{showHide = false;}
    }
}

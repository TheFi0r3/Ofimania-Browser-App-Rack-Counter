@inherits LayoutComponentBase
@inject NavigationManager NavigationManager;

<PageTitle>Ofimania Rack Counter</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="col-9" style="text-align:start">
                <img src="/img/ofimania_strip-logo.webp" width="100px" height="45px" />
            </div>
            <div>
                <label class="col-12 font-weight-bold">Bienvenido: [USER NAME]  .</label>

            </div>
            <div>
                <button class="btn btn-primary" @onclick="CloseSession">Logout</button>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {

    private void CloseSession()
    {
        NavigationManager.NavigateTo("/login");
    }

}